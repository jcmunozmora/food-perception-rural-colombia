!Arcila_etat_2026.pdf
!Analysis_Quantitative/analysis.html
!Analysis_Quantitative/panel_b_heatmap.pdf
!Participatory_Workshop_Evidence-Transcriptions/Pictures/**/*.png
!Participatory_Workshop_Evidence-Transcriptions/Pictures/**/*.jpg
!Participatory_Workshop_Evidence-Transcriptions/Pictures/**/*.jpeg

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop

